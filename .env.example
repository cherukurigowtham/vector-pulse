ENVIRONMENT=development

# Security
JWT_SECRET=replace_with_strong_random_secret
ADMIN_SECRET_KEY=replace_with_strong_random_secret

# HTTP / CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_PREFIX=vp:dev

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vector_pulse?sslmode=disable

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
