ADMIN_SECRET_KEY=replace_me
ADMIN_EMAILS=admin@example.com,security@example.com
SESSION_COOKIE_SECURE=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# Persistent Storage (Postgres/SQLite)
DATABASE_URL=postgresql://vector_pulse:vector_pulse@localhost:5432/vector_pulse
PILOT_REQUEST_WEBHOOK_URL=

CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# Extreme Risk Resilience
RISK_FAIL_CLOSED=false

# Risk Engine Thresholds
RISK_HISTORY_LEN=10
RISK_Z_SCORE_THRESHOLD=3.0
RISK_VELOCITY_WINDOW_SECS=5
RISK_VELOCITY_MAX_ORDERS=3
RISK_SYBIL_ADDRESS_LIMIT=3
RISK_DECISION_THRESHOLD=40

# Risk Weights
RISK_WEIGHT_VELOCITY=35
RISK_WEIGHT_SYBIL=25
RISK_WEIGHT_ANOMALY=20
RISK_WEIGHT_VPN=15
RISK_TRUST_FLOOR=30
RISK_TRUST_PENALTY_MULTIPLIER=0.5

# Operational Stats
RISK_SAVINGS_PER_BLOCK_INR=70

# Testing & Client
VECTOR_PULSE_API_URL=http://localhost:8000
VECTOR_PULSE_API_KEY=
